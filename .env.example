# Aria configuration — copy to .env and fill in. setup.sh does this for you.
# Only the three REQUIRED values are needed to start; everything else is optional
# and the feature it powers simply stays off until you set it.

# ── REQUIRED ──────────────────────────────────────────────────────────────
# Telegram bot token from @BotFather (https://t.me/BotFather → /newbot)
TELEGRAM_BOT_TOKEN=
# Your Telegram chat id. Leave blank, run the bot, message it once — it replies
# with your id in "setup mode" — then paste it here and restart.
TELEGRAM_ALLOWED_CHAT_ID=
# iMessage (macOS) — an ALTERNATIVE phone surface to Telegram, via imessage_bot.py.
# Your handle(s): phone in +countrycode form, or an email. Leave blank, run the bot,
# text it once: it replies in "setup mode" with the handle to paste here. Comma-separate
# for multiple. Needs Full Disk Access + Automation→Messages — see docs/imessage.md.
IMESSAGE_ALLOWED_HANDLES=
# Anthropic API key (https://console.anthropic.com) — Aria's primary brain.
ANTHROPIC_API_KEY=

# ── RECOMMENDED ───────────────────────────────────────────────────────────
# Your email — used as the morning-briefing recipient and the default send
# allowlist (so you don't need a separate allow.json).
USER_EMAIL=
# Google Gemini key (https://aistudio.google.com/apikey). Powers semantic
# memory (embeddings) and the final LLM fallback. Without it, memory degrades
# to the daily scratchpad only — Aria still runs.
GEMINI_API_KEY=

# ── EMAIL — pick ONE path ─────────────────────────────────────────────────
# EASY (no Google Cloud project): enable 2-step verification on your email,
# create an app password, and set it here. Works with Gmail, Fastmail, iCloud,
# any IMAP/SMTP host. Covers inbox triage, briefing send, and reply drafts.
EMAIL_APP_PASSWORD=
# IMAP/SMTP hosts default to Gmail; override for other providers.
IMAP_HOST=
SMTP_HOST=
SMTP_PORT=
# RICHER (Gmail API, needs credentials.json + auth_google.py): adds newsletter
# aggregation, carrier package search, Netflix automation, label-based triage.
# Leave EMAIL_APP_PASSWORD blank to use this path.

# ── OPTIONAL (per-feature) ────────────────────────────────────────────────
# Smart home via Home Assistant (Matter lights). See skills/home_assistant.py.
HA_URL=
HA_TOKEN=
# Spotify (developer.spotify.com/dashboard). Register the redirect URI below in the
# app settings, then run `python3 auth_spotify.py` once.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Local Whisper model size for voice notes: base (default) or tiny (Pi 4).
ARIA_WHISPER_MODEL=
# Realtime voice (voice_live.py / webvoice) uses GEMINI_API_KEY for Gemini Live. Override
# the model here if the default 2.5 native-audio preview isn't available on your key.
ARIA_LIVE_MODEL=
# webvoice friends-trial (see webvoice/deploy/HOSTING.md). Public URL friends use (for the
# add_friend link + the "open on your phone" print):
ARIA_PUBLIC_URL=
# How the public URL is served (HOSTING.md picks the mode):
#   - EC2/VPS with a public IP: leave the tunnel vars unset, put Caddy in front (recommended).
#   - home Pi/laptop (no public IP): set a Cloudflare Tunnel token (or a named tunnel) below.
CLOUDFLARE_TUNNEL_TOKEN=
ARIA_CF_TUNNEL=
# Per-friend daily caps so a guest can't run up your bill. Two gates — per-kind COUNT caps
# (voice sessions / brain calls) and an overall hard $/day ceiling across ALL actions
# (defaults: 12 / 60 / $5). Dollar figures are coarse estimates, tunable via
# ARIA_COST_TOKENS / ARIA_COST_AGENT / ARIA_COST_QUICK if your prices differ.
ARIA_GUEST_DAILY_TOKENS=
ARIA_GUEST_DAILY_AGENT=
ARIA_GUEST_DAILY_USD=
# Web Push for guest reminder notifications (so a reminder a guest sets actually pings their
# phone). Generate once:  python3 -c "from py_vapid import Vapid01; ..." (see webvoice/push.py).
# Private key is secret; public key is sent to the browser. iOS needs the PWA Added to Home
# Screen for push to deliver. Leave unset to disable push.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=
# Guest Gmail connect (ADR 0007): a SEPARATE Google "Web application" OAuth client (NOT the
# owner's credentials.json), read-only Gmail scope, redirect https://<host>/oauth/gmail/callback.
# Per-tenant tokens are encrypted at rest with ARIA_TOKEN_ENC_KEY (generate once:
#   python3 -c "import token_store; print(token_store.generate_key())"). All three required to
# enable guest Gmail; leave unset to keep guests account-free.
GUEST_GOOGLE_CLIENT_ID=
GUEST_GOOGLE_CLIENT_SECRET=
ARIA_TOKEN_ENC_KEY=
# Set to 1 to disable the proactivity engine (digests/chase/reminders).
ARIA_ENGINE_DISABLED=
# External dead-man's-switch: a healthchecks.io ping URL. Aria pings it every
# ~15 min; if pings stop (host dead/crashed), healthchecks.io emails you — the
# one failure she can't report herself. Free; set period ~20m, grace ~10m.
HEARTBEAT_URL=
# GCS allowlist bucket (original cloud deploy only; self-hosters leave blank —
# the local allow.json / USER_EMAIL is used instead).
ALLOWLIST_BUCKET_NAME=

# Note: Gmail + Calendar also need credentials.json (Google OAuth desktop
# client) in this folder, then a one-time `python3 auth_google.py`.
