[Unit]
Description=Aria morning briefing (compaction + briefing via morning_run.py)

[Service]
Type=oneshot
User={{USER}}
WorkingDirectory={{APP_DIR}}
ExecStart={{APP_DIR}}/venv/bin/python3 -u morning_run.py
StandardOutput=append:{{APP_DIR}}/logs/morning_briefing.log
StandardError=append:{{APP_DIR}}/logs/morning_briefing.err.log
